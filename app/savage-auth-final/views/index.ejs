<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>New Page from index.ejs</h1>
    <form action="/quotes" method="post">
      <input type="text" name="name" id="name" placeholder="name" />
      <input type="text" name="quote" id="quote" placeholder="quote" />
      <button type="submit">Submit</button>
    </form>
    <%= quotes %>
    <h2>Quotes</h2>

    <ul class="quotes">
      <% for(let i = 0; i < quotes.length; i++) {%>
      <li class="quote">
        <span><%= quotes[i].name %></span>:
        <span><%= quotes[i].quote %></span>
      </li>
      <% } %>
    </ul>

    <div>
      <h2>Darth Vader invades!</h2>
      <p>Replace first Yoda's quote with a quote written by Darth Vader</p>
      <button id="update-button">Replace Yoda's quote</button>
    </div>

    <div>
      <h2>Remove Darth Vader</h2>
      <p>Delete</p>
      <button id="delete-button">Delete Vader's quote</button>
    </div>
    
    <div id="message"></div>
    <script src="/main.js"></script>
  </body>
</html>